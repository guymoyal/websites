# Website Configuration
WEBSITE_TOPIC="AI Tools Directory"
WEBSITE_NAME="AI Tool Finder"
WEBSITE_DESCRIPTION="Discover and explore the best AI tools for every need"
WEBSITE_URL="https://your-domain.com"

# Content Generation (REQUIRED)
# Get your API key from: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Image Generation (OPTIONAL - Choose one)
# Option 1: Replicate (Recommended)
# Get token from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your-replicate-token-here

# Option 2: OpenAI DALL-E
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Image Configuration
IMAGE_PROVIDER=replicate  # Options: 'replicate', 'openai', 'placeholder'
IMAGE_GENERATION_ENABLED=true  # Set to false to use placeholder images

# Database (OPTIONAL - defaults to JSON files)
CONTENT_SOURCE=json  # Options: 'json' or 'supabase'

# Supabase Configuration (only if using CONTENT_SOURCE=supabase)
# Get credentials from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Monetization (OPTIONAL)
# Google AdSense - Apply at: https://adsense.google.com
GOOGLE_ADSENSE_CLIENT_ID=ca-pub-your-adsense-id

# Google Analytics - Create property at: https://analytics.google.com
GOOGLE_ANALYTICS_ID=G-your-analytics-id

# Email Service (OPTIONAL)
# EmailJS - Sign up at: https://emailjs.com
EMAILJS_SERVICE_ID=your-service-id
EMAILJS_TEMPLATE_ID=your-template-id
EMAILJS_PUBLIC_KEY=your-public-key

# Build Configuration
ARTICLES_TO_GENERATE=10  # Number of articles to generate