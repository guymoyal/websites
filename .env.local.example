# Website Configuration
WEBSITE_TOPIC="AI Tools Directory"
WEBSITE_NAME="AI Tool Finder"
WEBSITE_DESCRIPTION="Discover and explore the best AI tools for every need"
WEBSITE_URL="https://your-domain.com"

# Content — DeepSeek only (text). Run: yarn generate:content
# https://platform.deepseek.com — scripts load `.env` then `.env.local` (local overrides).
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Images / logos — OFF by default (avoids surprise bills).
# Do not set IMAGE_GENERATION_ENABLED=true unless you explicitly want paid image APIs.
IMAGE_PROVIDER=placeholder
IMAGE_GENERATION_ENABLED=false
# OpenRouter (often cheaper than DALL-E for article banners): set IMAGE_PROVIDER=openrouter + key + opt-in above.
# Default model is google/gemini-2.5-flash-image; for lowest resolution on Gemini 3.1 preview use 0.5K (see OpenRouter docs).
# OPEN_ROUTER_API_KEY=sk-or-key-here
# (Alias: OPENROUTER_API_KEY — same value if you already use that name.)
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# OPENROUTER_MODALITIES=image,text
# OPENROUTER_IMAGE_ASPECT_RATIO=16:9
# OPENROUTER_IMAGE_SIZE=0.5K
# OPENROUTER_APP_NAME=AI Buzz World
# Optional later (costs money): IMAGE_GENERATION_ENABLED=true + IMAGE_PROVIDER + keys
# GEMINI_API_KEY=
# REPLICATE_API_TOKEN=
# OPENAI_API_KEY=

# Database (OPTIONAL - defaults to JSON files)
CONTENT_SOURCE=json  # Options: 'json' or 'supabase'

# Supabase Configuration (only if using CONTENT_SOURCE=supabase)
# Get credentials from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admitad — fetch partner programs + default gotolink for your ad spaces (local script only).
# Create an API app in Admitad / Mitgo publisher settings; scopes: websites, advcampaigns_for_website; for catalog mode also advcampaigns.
# Run: pnpm fetch:admitad  → writes content/admitad-landings.json (landing paths + tracking URLs).
# By default the script enriches missing gotolink via GET /advcampaigns/{id}/website/{w_id}/ (set ADMIT_ENRICH_GOTOLINK=false to skip).
# Store “public programs” catalog (same idea as …/websites/2945005/catalog/…):
#   ADMIT_FETCH_MODE=catalog ADMIT_WEBSITE_ID=2945005 yarn fetch:admitad
# Optional: ADMIT_CATALOG_RESOLVE_LINKS=true (slow) fills gotolink via per-program API when possible.
# Optional: ADMIT_INCLUDE_PROGRAMS_WITHOUT_LINK=true keeps rows with null gotolink for landing stubs.
# ADMIT_CLIENT_ID=
# ADMIT_CLIENT_SECRET=
# Optional: precomputed Basic payload (base64 of "client_id:client_secret") if you prefer not to store the secret separately:
# ADMIT_BASE64_HEADER=
# Optional: limit to one ad space id from GET /websites/
# ADMIT_WEBSITE_ID=
# Optional: ADMIT_ENRICH_GOTOLINK=false disables per-program detail fetch for gotolink.
# Optional: ADMIT_SKIP_CONNECTION_FILTER=true includes pending/declined if they still expose gotolink (use carefully).

# Monetization (OPTIONAL)
#
# Partner banner (your own advertiser): no signup — negotiate a banner + link,
# upload image to CDN, set NEXT_PUBLIC_* vars below. Renders ahead of programmatic ads.
# NEXT_PUBLIC_SPONSOR_LABEL=Featured partner
# NEXT_PUBLIC_SPONSOR_HEADLINE=Short promotional line (optional)
# NEXT_PUBLIC_SPONSOR_IMAGE_URL=https://your-cdn/your-banner.png
# NEXT_PUBLIC_SPONSOR_LINK=https://partner-site.com?utm_source=aibuzz
#
# Affiliate row (recommended tools / programs): join programs individually
# (e.g. vendor partner portals, Impact, CJ, ShareASale), paste tracked URLs.
# One JSON array — keep on one line in .env or use quoting as your shell requires.
# NEXT_PUBLIC_AFFILIATES_JSON=[{"href":"https://example.com/?ref=x","title":"Tool name","subtitle":"One-line pitch","cta":"Try it"}]
#
# Google Analytics (GA4) — Web stream Measurement ID from Admin → Data streams.
# Prefer NEXT_PUBLIC_ so builds (e.g. Cloudflare Pages) reliably embed the tag.
# For GitHub Actions deploy workflow: add NEXT_PUBLIC_GOOGLE_ANALYTICS_ID as a Repository Variable.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-your-analytics-id
# Optional alias (reads on server/layout same as above if NEXT_PUBLIC unset):
GOOGLE_ANALYTICS_ID=G-your-analytics-id

# EzoicAds
# Docs: https://docs.ezoic.com/docs/ezoicads/integration/
#
# Production (`yarn build` / CI): Ezoic scripts are ON by default (see lib/ezoic.ts → isEzoicActive).
# To turn ads off in a production build: NEXT_PUBLIC_EZOIC_DISABLED=true
#
# Local dev (`yarn dev`): set NEXT_PUBLIC_EZOIC_ENABLED=true to load Ezoic (otherwise off).
#
# IMPORTANT (static export): placement JSON is read at build time — rebuild after changing.
# Setting vars only on the Cloudflare Worker does not change inlined HTML.
#
# For GitHub Actions: placement JSON variable still required for real ad slots; Ezoic "on" no longer needs NEXT_PUBLIC_EZOIC_ENABLED=true.
#
# Placement IDs: Ezoic dashboard — docs/ezoic-troubleshooting.md
# NEXT_PUBLIC_EZOIC_ENABLED=true
#
# Single-line JSON — keys in lib/ezoicZones.ts (include sitewideFooter for every-page footer slot).
# Replace numeric values with placement IDs from your Ezoic dashboard (Step 3). Example shape:
# NEXT_PUBLIC_EZOIC_PLACEMENTS_JSON={"homeTop":101,"homeBottom":102,"toolsTop":103,"toolsBottom":104,"categoriesTop":105,"categoriesBottom":106,"blogSidebar":107,"blogListingBottom":108,"articleTop":109,"articleMiddle":110,"articleBottom":111,"toolTop":112,"toolSidebar":113,"toolBottom":114,"sitewideFooter":115}
NEXT_PUBLIC_EZOIC_PLACEMENTS_JSON=
#
# ads.txt redirect (recommended): set in Wrangler Dashboard / wrangler.toml [vars] → EZOIC_ADSTXT_REDIRECT
# https://docs.ezoic.com/docs/ezoicads/adstxt/

# Email Service (OPTIONAL)
# EmailJS - Sign up at: https://emailjs.com
EMAILJS_SERVICE_ID=your-service-id
EMAILJS_TEMPLATE_ID=your-template-id
EMAILJS_PUBLIC_KEY=your-public-key

# Build Configuration
ARTICLES_TO_GENERATE=10  # Number of articles to generate